# Shell scripts and env templates must stay LF — CRLF breaks them on Linux CI/deploy.
*.sh text eol=lf
.githooks/* text eol=lf
*.env.example text eol=lf

# Node version pin — CRLF can trip Vercel's .nvmrc parser.
.nvmrc text eol=lf

# CI workflows — CRLF breaks `run:` shell blocks on Linux runners.
.github/workflows/*.yml text eol=lf

# Gradle wrapper — `gradlew` has no .sh extension but is a POSIX shell script;
# CRLF breaks `./gradlew` on Linux CI. The .jar must never be line-converted.
android/gradlew text eol=lf
android/gradlew.bat text eol=crlf
*.jar binary
