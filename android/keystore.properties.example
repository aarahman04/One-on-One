# Copy to android/keystore.properties (gitignored) to sign release builds.
#
#   cp keystore.properties.example keystore.properties
#
# Without this file, release builds are unsigned (fine for the debug/dev loop —
# Android Studio's Run button installs the debug variant regardless).
#
# storeFile is resolved relative to the android/ directory.
# The upload keystore + its passwords come from docs/_playstore-inputs.md
# (gitignored) or the CI secrets ANDROID_KEYSTORE_* .

storeFile=android.keystore
storePassword=
keyAlias=oneonone-upload
keyPassword=
