        android:fillColor="#FFFFFFFF"
        android:pathData="M36,96 a40,40 0 1,0 80,0 a40,40 0 1,0 -80,0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M76,96 a40,40 0 1,0 80,0 a40,40 0 1,0 -80,0 Z" />
