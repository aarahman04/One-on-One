# Copy to .env and fill in real values. Never commit .env.

# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=

# Supabase anon/public key (safe for client use, still keep out of git)
SUPABASE_ANON_KEY=

# Supabase service_role key (server only, bypasses RLS — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (server only)
DATABASE_URL=

# Google OAuth (set in Supabase dashboard, not read directly by app in V1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
