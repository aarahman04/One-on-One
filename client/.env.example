# Copy to .env and fill in real values from Supabase project settings. Never commit .env.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3000
# ^ dev value. Production builds (`npm run build`) get the deployed backend
# from the committed client/.env.production, which overrides this.

# Same VAPID_PUBLIC_KEY as backend/.env — the PUBLIC half only.
VITE_VAPID_PUBLIC_KEY=

# Optional. Native (Capacitor) Google sign-in only — the "Web" OAuth client ID
# for the Google Cloud project. Falls back to a hardcoded default; set this only
# to override for a different project. Public value (it's the ID token `aud`).
VITE_GOOGLE_WEB_CLIENT_ID=
