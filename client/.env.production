# Production build values (mode=production, i.e. `npm run build`). Vite loads
# this on top of `.env`, so it overrides the localhost dev defaults there.
# `npm run dev` (mode=development) never reads this file.
#
# COMMITTED ON PURPOSE — un-ignored in client/.gitignore. Public, non-secret
# build values ONLY. Never put keys, tokens or secrets in this file.
#
# Needed because the Capacitor/Android build runs `npm run build` locally with
# no shell env vars, so without this the APK would bake in http://localhost:3000
# (Vercel sets VITE_API_URL as a project env var, which is why web was fine).
# Already covered by the connect-src allowlist in index.html / vercel.json
# (https://*.up.railway.app + wss://*.up.railway.app).
VITE_API_URL=https://one-on-one-production-a5b8.up.railway.app
