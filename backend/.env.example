# Copy to .env and fill in real values from Supabase project settings. Never commit .env.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Web Push (optional — notifications silently disable if unset). Generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
