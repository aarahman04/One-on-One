# Copy to .env and fill in real values from Supabase project settings. Never commit .env.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Web Push (optional — notifications silently disable if unset). Generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Message encryption at rest (Option C — required, server won't start without it).
# base64 of 32 random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# To rotate, add ENCRYPTION_KEY_V2 (new writes use the highest version; keep old
# versions so existing rows still decrypt) — see docs/DECISIONS-encryption-at-rest.md.
ENCRYPTION_KEY_V1=
